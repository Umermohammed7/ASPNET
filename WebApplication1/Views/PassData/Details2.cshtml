@model ClientProduitViewModel

<!DOCTYPE html>
<html>
<head>
    <title>Détails de la commande</title>
</head>
<body>
    <h1>Détails de la commande</h1>
    <h2>Produit</h2>
    <p>Id : @Model.produits.Id</p>
    <p>Nom : @Model.produits.Name</p>
    <p>Prix : @Model.produits.Price €</p>

    <h2>Client</h2>
    <p>Id : @Model.clients.Id</p>
    <p>Nom : @Model.clients.Name</p>
    <p>Email : @Model.clients.Email</p>
</body>
</html>
