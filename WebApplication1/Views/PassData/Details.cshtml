@{
    var paiement = ViewData["Paiement"] as Paiement; // ici on peut avoir un objet 
   // var paiement = ViewBag["Paiement"] as Paiement; // ici on peut avoir qu'une seule valeur donc ça ne va pas marcher 
}



<form>
    <h1>Récap Commande</h1>
